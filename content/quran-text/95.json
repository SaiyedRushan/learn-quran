{"number":95,"arabicName":"التين","englishName":"At-Tin","englishNameTranslation":"The Fig","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":1,"arabic":"وَٱلتِّينِ وَٱلزَّيْتُونِ"},{"number":2,"arabic":"وَطُورِ سِينِينَ"},{"number":3,"arabic":"وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ"},{"number":4,"arabic":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ"},{"number":5,"arabic":"ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ"},{"number":6,"arabic":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ"},{"number":7,"arabic":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ"},{"number":8,"arabic":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ"}]}
