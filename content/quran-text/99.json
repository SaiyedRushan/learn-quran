{"number":99,"arabicName":"الزلزلة","englishName":"Az-Zalzalah","englishNameTranslation":"The Earthquake","revelationType":"Medinan","numberOfAyahs":8,"ayahs":[{"number":1,"arabic":"إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا"},{"number":2,"arabic":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا"},{"number":3,"arabic":"وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا"},{"number":4,"arabic":"يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا"},{"number":5,"arabic":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا"},{"number":6,"arabic":"يَوْمَئِذٍ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًا لِّيُرَوْا۟ أَعْمَـٰلَهُمْ"},{"number":7,"arabic":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ"},{"number":8,"arabic":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ"}]}
