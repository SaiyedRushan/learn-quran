{"number":84,"arabicName":"الإنشقاق","englishName":"Al-Inshiqaq","englishNameTranslation":"The Sundering","revelationType":"Meccan","numberOfAyahs":25,"ayahs":[{"number":1,"arabic":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ"},{"number":2,"arabic":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"number":3,"arabic":"وَإِذَا ٱلْأَرْضُ مُدَّتْ"},{"number":4,"arabic":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"},{"number":5,"arabic":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"number":6,"arabic":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَـٰقِيهِ"},{"number":7,"arabic":"فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ"},{"number":8,"arabic":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا"},{"number":9,"arabic":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا"},{"number":10,"arabic":"وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ"},{"number":11,"arabic":"فَسَوْفَ يَدْعُوا۟ ثُبُورًا"},{"number":12,"arabic":"وَيَصْلَىٰ سَعِيرًا"},{"number":13,"arabic":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا"},{"number":14,"arabic":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"},{"number":15,"arabic":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا"},{"number":16,"arabic":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ"},{"number":17,"arabic":"وَٱلَّيْلِ وَمَا وَسَقَ"},{"number":18,"arabic":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ"},{"number":19,"arabic":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ"},{"number":20,"arabic":"فَمَا لَهُمْ لَا يُؤْمِنُونَ"},{"number":21,"arabic":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩"},{"number":22,"arabic":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ"},{"number":23,"arabic":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ"},{"number":24,"arabic":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ"},{"number":25,"arabic":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ"}]}
