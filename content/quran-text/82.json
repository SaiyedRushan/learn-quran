{"number":82,"arabicName":"الإنفطار","englishName":"Al-Infitar","englishNameTranslation":"The Cleaving","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":1,"arabic":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ"},{"number":2,"arabic":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ"},{"number":3,"arabic":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ"},{"number":4,"arabic":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ"},{"number":5,"arabic":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ"},{"number":6,"arabic":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ"},{"number":7,"arabic":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ"},{"number":8,"arabic":"فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ"},{"number":9,"arabic":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ"},{"number":10,"arabic":"وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ"},{"number":11,"arabic":"كِرَامًا كَـٰتِبِينَ"},{"number":12,"arabic":"يَعْلَمُونَ مَا تَفْعَلُونَ"},{"number":13,"arabic":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ"},{"number":14,"arabic":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ"},{"number":15,"arabic":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ"},{"number":16,"arabic":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ"},{"number":17,"arabic":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"},{"number":18,"arabic":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"},{"number":19,"arabic":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ"}]}
