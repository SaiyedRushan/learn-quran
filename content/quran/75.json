{
  "number": 75,
  "arabicName": "سُورَةُ القِيَامَةِ",
  "englishName": "Al-Qiyaama",
  "englishNameTranslation": "The Resurrection",
  "revelationType": "Meccan",
  "numberOfAyahs": 40,
  "ayahs": [
    {
      "number": 1,
      "arabic": "لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ",
      "transliteration": "Lā uqsimu biyawmi-l-qiyāmat",
      "translation": "I swear by the Day of Resurrection"
    },
    {
      "number": 2,
      "arabic": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ",
      "transliteration": "Walā uqsimu bin-nafsi-l-lawwāmat",
      "translation": "And I swear by the reproaching soul [to the certainty of resurrection]."
    },
    {
      "number": 3,
      "arabic": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
      "transliteration": "Ayaḥsabu-l-ʾinsānu allan najmaʿa ʿiẓāmah",
      "translation": "Does man think that We will not assemble his bones?"
    },
    {
      "number": 4,
      "arabic": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ",
      "transliteration": "Balā qādirīna ʿalā an nusawwiya banānah",
      "translation": "Yes. [We are] Able [even] to proportion his fingertips."
    },
    {
      "number": 5,
      "arabic": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ",
      "transliteration": "Bal yurīdu-l-ʾinsānu liyafjura amāmah",
      "translation": "But man desires to continue in sin."
    },
    {
      "number": 6,
      "arabic": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ",
      "transliteration": "Yasʾalu ayyāna yawmu-l-qiyāmat",
      "translation": "He asks, \"When is the Day of Resurrection?\""
    },
    {
      "number": 7,
      "arabic": "فَإِذَا بَرِقَ ٱلْبَصَرُ",
      "transliteration": "Faʾidhā bariqa-l-baṣar",
      "translation": "So when vision is dazzled"
    },
    {
      "number": 8,
      "arabic": "وَخَسَفَ ٱلْقَمَرُ",
      "transliteration": "Wakhasafa-l-qamar",
      "translation": "And the moon darkens"
    },
    {
      "number": 9,
      "arabic": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ",
      "transliteration": "Wajumiʿa-sh-shamsu wal-qamar",
      "translation": "And the sun and the moon are joined,"
    },
    {
      "number": 10,
      "arabic": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ",
      "transliteration": "Yaqūlu-l-ʾinsānu yawmaʾidhin ayna-l-mafarr",
      "translation": "Man will say on that Day, \"Where is the [place of] escape?\""
    },
    {
      "number": 11,
      "arabic": "كَلَّا لَا وَزَرَ",
      "transliteration": "Kallā lā wazar",
      "translation": "No! There is no refuge."
    },
    {
      "number": 12,
      "arabic": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ",
      "transliteration": "Ilā rabbika yawmaʾidhin al-mustaqarr",
      "translation": "To your Lord, that Day, is the [place of] permanence."
    },
    {
      "number": 13,
      "arabic": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ",
      "transliteration": "Yunabbaʾu-l-ʾinsānu yawmaʾidhin bimā qaddama waʾakhkhar",
      "translation": "Man will be informed that Day of what he sent ahead and kept back."
    },
    {
      "number": 14,
      "arabic": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ",
      "transliteration": "Bali-l-ʾinsānu ʿalā nafsihi baṣīrat",
      "translation": "Rather, man, against himself, will be a witness,"
    },
    {
      "number": 15,
      "arabic": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ",
      "transliteration": "Walaw alqā maʿādhīrah",
      "translation": "Even if he presents his excuses."
    },
    {
      "number": 16,
      "arabic": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
      "transliteration": "Lā tuḥarrik bihi lisānaka litaʿjala bih",
      "translation": "Move not your tongue with it, [O Muhammad], to hasten with recitation of the Qur'an."
    },
    {
      "number": 17,
      "arabic": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
      "transliteration": "Inna ʿalaynā jamʿahu waqurʾānah",
      "translation": "Indeed, upon Us is its collection [in your heart] and [to make possible] its recitation."
    },
    {
      "number": 18,
      "arabic": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
      "transliteration": "Faʾidhā qaraʾnāhu fāttabiʿ qurʾānah",
      "translation": "So when We have recited it [through Gabriel], then follow its recitation."
    },
    {
      "number": 19,
      "arabic": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ",
      "transliteration": "Thumma inna ʿalaynā bayānah",
      "translation": "Then upon Us is its clarification [to you]."
    },
    {
      "number": 20,
      "arabic": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ",
      "transliteration": "Kallā bal tuḥibbūna-l-ʿājilat",
      "translation": "No! But you love the immediate"
    },
    {
      "number": 21,
      "arabic": "وَتَذَرُونَ ٱلْءَاخِرَةَ",
      "transliteration": "Watadharūna-l-ʾākhirat",
      "translation": "And leave the Hereafter."
    },
    {
      "number": 22,
      "arabic": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ",
      "transliteration": "Wujūhun yawmaʾidhin nāḍirat",
      "translation": "[Some] faces, that Day, will be radiant,"
    },
    {
      "number": 23,
      "arabic": "إِلَىٰ رَبِّهَا نَاظِرَةٌۭ",
      "transliteration": "Ilā rabbihā nāẓirat",
      "translation": "Looking at their Lord."
    },
    {
      "number": 24,
      "arabic": "وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ",
      "transliteration": "Wawujūhun yawmaʾidhin bāsirat",
      "translation": "And [some] faces, that Day, will be contorted,"
    },
    {
      "number": 25,
      "arabic": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ",
      "transliteration": "Taẓunnu an yufʿala bihā fāqirat",
      "translation": "Expecting that there will be done to them [something] backbreaking."
    },
    {
      "number": 26,
      "arabic": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ",
      "transliteration": "Kallā idhā balaghati-t-tarāqiy",
      "translation": "No! When the soul has reached the collar bones"
    },
    {
      "number": 27,
      "arabic": "وَقِيلَ مَنْ ۜ رَاقٍۢ",
      "transliteration": "Waqīla man rāq",
      "translation": "And it is said, \"Who will cure [him]?\""
    },
    {
      "number": 28,
      "arabic": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ",
      "transliteration": "Waẓanna annahu-l-firāq",
      "translation": "And the dying one is certain that it is the [time of] separation"
    },
    {
      "number": 29,
      "arabic": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ",
      "transliteration": "Wal-taffati-s-sāqu bis-sāq",
      "translation": "And the leg is wound about the leg,"
    },
    {
      "number": 30,
      "arabic": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ",
      "transliteration": "Ilā rabbika yawmaʾidhin al-masāq",
      "translation": "To your Lord, that Day, will be the procession."
    },
    {
      "number": 31,
      "arabic": "فَلَا صَدَّقَ وَلَا صَلَّىٰ",
      "transliteration": "Falā ṣaddaqa walā ṣallā",
      "translation": "And the disbeliever had not believed, nor had he prayed."
    },
    {
      "number": 32,
      "arabic": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ",
      "transliteration": "Walākin kadhdhaba watawallā",
      "translation": "But [instead], he denied and turned away."
    },
    {
      "number": 33,
      "arabic": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ",
      "transliteration": "Thumma dhahaba ilā ahlihi yatamaṭṭā",
      "translation": "And then he went to his people, swaggering [in pride]."
    },
    {
      "number": 34,
      "arabic": "أَوْلَىٰ لَكَ فَأَوْلَىٰ",
      "transliteration": "Awlā laka faʾawlā",
      "translation": "Woe to you, and woe!"
    },
    {
      "number": 35,
      "arabic": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ",
      "transliteration": "Thumma awlā laka faʾawlā",
      "translation": "Then woe to you, and woe!"
    },
    {
      "number": 36,
      "arabic": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى",
      "transliteration": "Ayaḥsabu-l-ʾinsānu an yutraka sudā",
      "translation": "Does man think that he will be left neglected?"
    },
    {
      "number": 37,
      "arabic": "أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ",
      "transliteration": "Alam yaku nuṭfatan min maniyyin yumnā",
      "translation": "Had he not been a sperm from semen emitted?"
    },
    {
      "number": 38,
      "arabic": "ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ",
      "transliteration": "Thumma kāna ʿalaqatan fakhalaqa fasawwā",
      "translation": "Then he was a clinging clot, and [Allah] created [his form] and proportioned [him]"
    },
    {
      "number": 39,
      "arabic": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "transliteration": "Fajaʿala minhu-z-zawjayni-dh-dhakara wal-ʾunthā",
      "translation": "And made of him two mates, the male and the female."
    },
    {
      "number": 40,
      "arabic": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ",
      "transliteration": "Alaysa dhālika biqādirin ʿalā an yuḥyiya-l-mawtā",
      "translation": "Is not that [Creator] Able to give life to the dead?"
    }
  ]
}
