{
  "number": 81,
  "arabicName": "سُورَةُ التَّكۡوِيرِ",
  "englishName": "At-Takwir",
  "englishNameTranslation": "The Overthrowing",
  "revelationType": "Meccan",
  "numberOfAyahs": 29,
  "ayahs": [
    {
      "number": 1,
      "arabic": "إِذَا ٱلشَّمْسُ كُوِّرَتْ",
      "arabicIndopak": "اِذَا الشَّمۡسُ كُوِّرَتۡۙ‏",
      "transliteration": "Idhā-sh-shamsu kuwwirat",
      "translation": "When the sun is wrapped up [in darkness]"
    },
    {
      "number": 2,
      "arabic": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
      "arabicIndopak": "وَاِذَا النُّجُوۡمُ انْكَدَرَتۡۙ‏",
      "transliteration": "Waʾidhā-n-nujūmu-nkadarat",
      "translation": "And when the stars fall, dispersing,"
    },
    {
      "number": 3,
      "arabic": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
      "arabicIndopak": "وَاِذَا الۡجِبَالُ سُيِّرَتۡۙ‏",
      "transliteration": "Waʾidhā-l-jibālu suyyirat",
      "translation": "And when the mountains are removed"
    },
    {
      "number": 4,
      "arabic": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
      "arabicIndopak": "وَاِذَا الۡعِشَارُ عُطِّلَتۡۙ‏",
      "transliteration": "Waʾidhā-l-ʿishāru ʿuṭṭilat",
      "translation": "And when full-term she-camels are neglected"
    },
    {
      "number": 5,
      "arabic": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
      "arabicIndopak": "وَاِذَا الۡوُحُوۡشُ حُشِرَتۡۙ‏",
      "transliteration": "Waʾidhā-l-wuḥūshu ḥushirat",
      "translation": "And when the wild beasts are gathered"
    },
    {
      "number": 6,
      "arabic": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
      "arabicIndopak": "وَاِذَا الۡبِحَارُ سُجِّرَتۡۙ‏",
      "transliteration": "Waʾidhā-l-biḥāru sujjirat",
      "translation": "And when the seas are filled with flame"
    },
    {
      "number": 7,
      "arabic": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
      "arabicIndopak": "وَاِذَا النُّفُوۡسُ زُوِّجَتۡۙ‏",
      "transliteration": "Waʾidhā-n-nufūsu zuwwijat",
      "translation": "And when the souls are paired"
    },
    {
      "number": 8,
      "arabic": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
      "arabicIndopak": "وَاِذَا الۡمَوۡءٗدَةُ سُٮِٕلَتۡۙ‏",
      "transliteration": "Waʾidhā-l-mawʾūdatu suʾilat",
      "translation": "And when the girl [who was] buried alive is asked"
    },
    {
      "number": 9,
      "arabic": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
      "arabicIndopak": "بِاَىِّ ذَنۡۢبٍ قُتِلَتۡ​ۚ‏",
      "transliteration": "Biʾayyi dhanbin qutilat",
      "translation": "For what sin she was killed"
    },
    {
      "number": 10,
      "arabic": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
      "arabicIndopak": "وَاِذَا الصُّحُفُ نُشِرَتۡۙ‏",
      "transliteration": "Waʾidhā-ṣ-ṣuḥufu nushirat",
      "translation": "And when the pages are made public"
    },
    {
      "number": 11,
      "arabic": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
      "arabicIndopak": "وَاِذَا السَّمَآءُ كُشِطَتۡۙ‏",
      "transliteration": "Waʾidhā-s-samāʾu kushiṭat",
      "translation": "And when the sky is stripped away"
    },
    {
      "number": 12,
      "arabic": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
      "arabicIndopak": "وَاِذَا الۡجَحِيۡمُ سُعِّرَتۡۙ‏",
      "transliteration": "Waʾidhā-l-jaḥīmu suʿʿirat",
      "translation": "And when Hellfire is set ablaze"
    },
    {
      "number": 13,
      "arabic": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
      "arabicIndopak": "وَاِذَا الۡجَـنَّةُ اُزۡلِفَتۡۙ‏",
      "transliteration": "Waʾidhā-l-jannatu uzlifat",
      "translation": "And when Paradise is brought near,"
    },
    {
      "number": 14,
      "arabic": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
      "arabicIndopak": "عَلِمَتۡ نَفۡسٌ مَّاۤ اَحۡضَرَتۡؕ‏",
      "transliteration": "ʿAlimat nafsun mā aḥḍarat",
      "translation": "A soul will [then] know what it has brought [with it]."
    },
    {
      "number": 15,
      "arabic": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
      "arabicIndopak": "فَلَاۤ اُقۡسِمُ بِالۡخُنَّسِۙ‏",
      "transliteration": "Falā uqsimu bil-khunnas",
      "translation": "So I swear by the retreating stars -"
    },
    {
      "number": 16,
      "arabic": "ٱلْجَوَارِ ٱلْكُنَّسِ",
      "arabicIndopak": "الۡجَوَارِ الۡكُنَّسِۙ‏",
      "transliteration": "Al-jawāri-l-kunnas",
      "translation": "Those that run [their courses] and disappear -"
    },
    {
      "number": 17,
      "arabic": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
      "arabicIndopak": "وَالَّيۡلِ اِذَا عَسۡعَسَۙ‏",
      "transliteration": "Wal-layli idhā ʿasʿas",
      "translation": "And by the night as it closes in"
    },
    {
      "number": 18,
      "arabic": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
      "arabicIndopak": "وَالصُّبۡحِ اِذَا تَنَفَّسَۙ‏",
      "transliteration": "Waṣ-ṣubḥi idhā tanaffas",
      "translation": "And by the dawn when it breathes"
    },
    {
      "number": 19,
      "arabic": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
      "arabicIndopak": "اِنَّهٗ لَقَوۡلُ رَسُوۡلٍ كَرِيۡمٍۙ‏",
      "transliteration": "Innahu laqawlu rasūlin karīm",
      "translation": "[That] indeed, the Qur'an is a word [conveyed by] a noble messenger"
    },
    {
      "number": 20,
      "arabic": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
      "arabicIndopak": "ذِىۡ قُوَّةٍ عِنۡدَ ذِى الۡعَرۡشِ مَكِيۡنٍۙ‏",
      "transliteration": "Dhī quwwatin ʿinda dhī-l-ʿarshi makīn",
      "translation": "[Who is] possessed of power and with the Owner of the Throne, secure [in position],"
    },
    {
      "number": 21,
      "arabic": "مُّطَاعٍ ثَمَّ أَمِينٍ",
      "arabicIndopak": "مُّطَاعٍ ثَمَّ اَمِيۡنٍؕ‏",
      "transliteration": "Muṭāʿin thamma amīn",
      "translation": "Obeyed there [in the heavens] and trustworthy."
    },
    {
      "number": 22,
      "arabic": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
      "arabicIndopak": "وَ مَا صَاحِبُكُمۡ بِمَجۡنُوۡنٍ​ۚ‏",
      "transliteration": "Wamā ṣāḥibukum bimajnūn",
      "translation": "And your companion is not [at all] mad."
    },
    {
      "number": 23,
      "arabic": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
      "arabicIndopak": "وَلَقَدۡ رَاٰهُ بِالۡاُفُقِ الۡمُبِيۡنِ​ۚ‏",
      "transliteration": "Walaqad raʾāhu bil-ʾufuqi-l-mubīn",
      "translation": "And he has already seen Gabriel in the clear horizon."
    },
    {
      "number": 24,
      "arabic": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
      "arabicIndopak": "وَمَا هُوَ عَلَى الۡغَيۡبِ بِضَنِيۡنٍ​ۚ‏",
      "transliteration": "Wamā huwa ʿalā-l-ghaybi biḍanīn",
      "translation": "And Muhammad is not a withholder of [knowledge of] the unseen."
    },
    {
      "number": 25,
      "arabic": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
      "arabicIndopak": "وَمَا هُوَ بِقَوۡلِ شَيۡطٰنٍ رَّجِيۡمٍۙ‏",
      "transliteration": "Wamā huwa biqawli shayṭānin rajīm",
      "translation": "And the Qur'an is not the word of a devil, expelled [from the heavens]."
    },
    {
      "number": 26,
      "arabic": "فَأَيْنَ تَذْهَبُونَ",
      "arabicIndopak": "فَاَيۡنَ تَذۡهَبُوۡنَؕ‏",
      "transliteration": "Faʾayna tadhhabūn",
      "translation": "So where are you going?"
    },
    {
      "number": 27,
      "arabic": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
      "arabicIndopak": "اِنۡ هُوَ اِلَّا ذِكۡرٌ لِّلۡعٰلَمِيۡنَۙ‏",
      "transliteration": "In huwa illā dhikrun lil-ʿālamīn",
      "translation": "It is not except a reminder to the worlds"
    },
    {
      "number": 28,
      "arabic": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
      "arabicIndopak": "لِمَنۡ شَآءَ مِنۡكُمۡ اَنۡ يَّسۡتَقِيۡمَؕ‏",
      "transliteration": "Liman shāʾa minkum an yastaqīm",
      "translation": "For whoever wills among you to take a right course."
    },
    {
      "number": 29,
      "arabic": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
      "arabicIndopak": "وَمَا تَشَآءُوۡنَ اِلَّاۤ اَنۡ يَّشَآءَ اللّٰهُ رَبُّ الۡعٰلَمِيۡنَ‏",
      "transliteration": "Wamā tashāʾūna illā an yashāʾa-llāhu rabbu-l-ʿālamīn",
      "translation": "And you do not will except that Allah wills - Lord of the worlds."
    }
  ]
}
