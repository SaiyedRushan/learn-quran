{
  "number": 101,
  "arabicName": "سُورَةُ القَارِعَةِ",
  "englishName": "Al-Qaari'a",
  "englishNameTranslation": "The Calamity",
  "revelationType": "Meccan",
  "numberOfAyahs": 11,
  "ayahs": [
    {
      "number": 1,
      "arabic": "ٱلْقَارِعَةُ",
      "arabicIndopak": "اَلۡقَارِعَةُ ۙ‏",
      "transliteration": "Al-qāriʿat",
      "translation": "The Striking Calamity -"
    },
    {
      "number": 2,
      "arabic": "مَا ٱلْقَارِعَةُ",
      "arabicIndopak": "مَا الۡقَارِعَةُ​ ۚ‏",
      "transliteration": "Mā-l-qāriʿat",
      "translation": "What is the Striking Calamity?"
    },
    {
      "number": 3,
      "arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ",
      "arabicIndopak": "وَمَاۤ اَدۡرٰٮكَ مَا الۡقَارِعَةُ ؕ‏",
      "transliteration": "Wamā adrāka mā-l-qāriʿat",
      "translation": "And what can make you know what is the Striking Calamity?"
    },
    {
      "number": 4,
      "arabic": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ",
      "arabicIndopak": "يَوۡمَ يَكُوۡنُ النَّاسُ كَالۡفَرَاشِ الۡمَبۡثُوۡثِۙ‏",
      "transliteration": "Yawma yakūnu-n-nāsu kal-farāshi-l-mabthūth",
      "translation": "It is the Day when people will be like moths, dispersed,"
    },
    {
      "number": 5,
      "arabic": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ",
      "arabicIndopak": "وَتَكُوۡنُ الۡجِبَالُ كَالۡعِهۡنِ الۡمَنۡفُوۡشِؕ‏",
      "transliteration": "Watakūnu-l-jibālu kal-ʿihni-l-manfūsh",
      "translation": "And the mountains will be like wool, fluffed up."
    },
    {
      "number": 6,
      "arabic": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ",
      "arabicIndopak": "فَاَمَّا مَنۡ ثَقُلَتۡ مَوَازِيۡنُهٗ ۙ‏",
      "transliteration": "Faʾammā man thaqulat mawāzīnuh",
      "translation": "Then as for one whose scales are heavy [with good deeds],"
    },
    {
      "number": 7,
      "arabic": "فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ",
      "arabicIndopak": "فَهُوَ فِىۡ عِيۡشَةٍ رَّاضِيَةٍ ؕ‏",
      "transliteration": "Fahuwa fī ʿīshatin rāḍiyat",
      "translation": "He will be in a pleasant life."
    },
    {
      "number": 8,
      "arabic": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ",
      "arabicIndopak": "وَاَمَّا مَنۡ خَفَّتۡ مَوَازِيۡنُهٗ ۙ‏",
      "transliteration": "Waʾammā man khaffat mawāzīnuh",
      "translation": "But as for one whose scales are light,"
    },
    {
      "number": 9,
      "arabic": "فَأُمُّهُۥ هَاوِيَةٌ",
      "arabicIndopak": "فَاُمُّهٗ هَاوِيَةٌ ؕ‏",
      "transliteration": "Faʾummuhu hāwiyat",
      "translation": "His refuge will be an abyss."
    },
    {
      "number": 10,
      "arabic": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ",
      "arabicIndopak": "وَمَاۤ اَدۡرٰٮكَ مَا هِيَهۡ ؕ‏",
      "transliteration": "Wamā adrāka mā hiyah",
      "translation": "And what can make you know what that is?"
    },
    {
      "number": 11,
      "arabic": "نَارٌ حَامِيَةٌۢ",
      "arabicIndopak": "نَارٌ حَامِيَةٌ‏",
      "transliteration": "Nārun ḥāmiyat",
      "translation": "It is a Fire, intensely hot."
    }
  ]
}
