{
  "number": 80,
  "arabicName": "سُورَةُ عَبَسَ",
  "englishName": "Abasa",
  "englishNameTranslation": "He frowned",
  "revelationType": "Meccan",
  "numberOfAyahs": 42,
  "ayahs": [
    {
      "number": 1,
      "arabic": "عَبَسَ وَتَوَلَّىٰٓ",
      "arabicIndopak": "عَبَسَ وَتَوَلّٰٓىۙ‏",
      "transliteration": "ʿAbasa watawallā",
      "translation": "The Prophet frowned and turned away"
    },
    {
      "number": 2,
      "arabic": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
      "arabicIndopak": "اَنۡ جَآءَهُ الۡاَعۡمٰىؕ‏",
      "transliteration": "An jāʾahu-l-ʾaʿmā",
      "translation": "Because there came to him the blind man, [interrupting]."
    },
    {
      "number": 3,
      "arabic": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
      "arabicIndopak": "وَمَا يُدۡرِيۡكَ لَعَلَّهٗ يَزَّكّٰٓىۙ‏",
      "transliteration": "Wamā yudrīka laʿallahu yazzakkā",
      "translation": "But what would make you perceive, [O Muhammad], that perhaps he might be purified"
    },
    {
      "number": 4,
      "arabic": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
      "arabicIndopak": "اَوۡ يَذَّكَّرُ فَتَنۡفَعَهُ الذِّكۡرٰىؕ‏",
      "transliteration": "Aw yadhdhakkaru fatanfaʿahu-dh-dhikrā",
      "translation": "Or be reminded and the remembrance would benefit him?"
    },
    {
      "number": 5,
      "arabic": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
      "arabicIndopak": "اَمَّا مَنِ اسۡتَغۡنٰىۙ‏",
      "transliteration": "Ammā mani-staghnā",
      "translation": "As for he who thinks himself without need,"
    },
    {
      "number": 6,
      "arabic": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
      "arabicIndopak": "فَاَنۡتَ لَهٗ تَصَدّٰىؕ‏",
      "transliteration": "Faʾanta lahu taṣaddā",
      "translation": "To him you give attention."
    },
    {
      "number": 7,
      "arabic": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
      "arabicIndopak": "وَمَا عَلَيۡكَ اَلَّا يَزَّكّٰٓىؕ‏",
      "transliteration": "Wamā ʿalayka allā yazzakkā",
      "translation": "And not upon you [is any blame] if he will not be purified."
    },
    {
      "number": 8,
      "arabic": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
      "arabicIndopak": "وَاَمَّا مَنۡ جَآءَكَ يَسۡعٰىۙ‏",
      "transliteration": "Waʾammā man jāʾaka yasʿā",
      "translation": "But as for he who came to you striving [for knowledge]"
    },
    {
      "number": 9,
      "arabic": "وَهُوَ يَخْشَىٰ",
      "arabicIndopak": "وَهُوَ يَخۡشٰىۙ‏",
      "transliteration": "Wahuwa yakhshā",
      "translation": "While he fears [Allah],"
    },
    {
      "number": 10,
      "arabic": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
      "arabicIndopak": "فَاَنۡتَ عَنۡهُ تَلَهّٰى​ۚ‏",
      "transliteration": "Faʾanta ʿanhu talahhā",
      "translation": "From him you are distracted."
    },
    {
      "number": 11,
      "arabic": "كَلَّآ إِنَّهَا تَذْكِرَةٌ",
      "arabicIndopak": "كَلَّاۤ اِنَّهَا تَذۡكِرَةٌ ۚ‏",
      "transliteration": "Kallā innahā tadhkirat",
      "translation": "No! Indeed, these verses are a reminder;"
    },
    {
      "number": 12,
      "arabic": "فَمَن شَآءَ ذَكَرَهُۥ",
      "arabicIndopak": "فَمَنۡ شَآءَ ذَكَرَهٗ​ۘ‏",
      "transliteration": "Faman shāʾa dhakarah",
      "translation": "So whoever wills may remember it."
    },
    {
      "number": 13,
      "arabic": "فِى صُحُفٍ مُّكَرَّمَةٍ",
      "arabicIndopak": "فِىۡ صُحُفٍ مُّكَرَّمَةٍۙ‏",
      "transliteration": "Fī ṣuḥufin mukarramat",
      "translation": "[It is recorded] in honored sheets,"
    },
    {
      "number": 14,
      "arabic": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ",
      "arabicIndopak": "مَّرۡفُوۡعَةٍ مُّطَهَّرَةٍ ۭۙ‏",
      "transliteration": "Marfūʿatin muṭahharat",
      "translation": "Exalted and purified,"
    },
    {
      "number": 15,
      "arabic": "بِأَيْدِى سَفَرَةٍ",
      "arabicIndopak": "بِاَيۡدِىۡ سَفَرَةٍۙ‏",
      "transliteration": "Biʾaydī safarat",
      "translation": "[Carried] by the hands of messenger-angels,"
    },
    {
      "number": 16,
      "arabic": "كِرَامٍۭ بَرَرَةٍ",
      "arabicIndopak": "كِرَامٍۢ بَرَرَةٍؕ‏",
      "transliteration": "Kirāmin bararat",
      "translation": "Noble and dutiful."
    },
    {
      "number": 17,
      "arabic": "قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ",
      "arabicIndopak": "قُتِلَ الۡاِنۡسَانُ مَاۤ اَكۡفَرَهٗؕ‏",
      "transliteration": "Qutila-l-ʾinsānu mā akfarah",
      "translation": "Cursed is man; how disbelieving is he."
    },
    {
      "number": 18,
      "arabic": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
      "arabicIndopak": "مِنۡ اَىِّ شَىۡءٍ خَلَقَهٗؕ‏",
      "transliteration": "Min ayyi shayʾin khalaqah",
      "translation": "From what substance did He create him?"
    },
    {
      "number": 19,
      "arabic": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
      "arabicIndopak": "مِنۡ نُّطۡفَةٍؕ خَلَقَهٗ فَقَدَّرَهٗ ۙ‏",
      "transliteration": "Min nuṭfatin khalaqahu faqaddarah",
      "translation": "From a sperm-drop He created him and destined for him;"
    },
    {
      "number": 20,
      "arabic": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
      "arabicIndopak": "ثُمَّ السَّبِيۡلَ يَسَّرَهٗۙ‏",
      "transliteration": "Thumma-s-sabīla yassarah",
      "translation": "Then He eased the way for him;"
    },
    {
      "number": 21,
      "arabic": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
      "arabicIndopak": "ثُمَّ اَمَاتَهٗ فَاَقۡبَرَهٗۙ‏",
      "transliteration": "Thumma amātahu faʾaqbarah",
      "translation": "Then He causes his death and provides a grave for him."
    },
    {
      "number": 22,
      "arabic": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
      "arabicIndopak": "ثُمَّ اِذَا شَآءَ اَنۡشَرَهٗؕ‏",
      "transliteration": "Thumma idhā shāʾa ansharah",
      "translation": "Then when He wills, He will resurrect him."
    },
    {
      "number": 23,
      "arabic": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
      "arabicIndopak": "كَلَّا لَـمَّا يَقۡضِ مَاۤ اَمَرَهٗؕ‏",
      "transliteration": "Kallā lammā yaqḍi mā amarah",
      "translation": "No! Man has not yet accomplished what He commanded him."
    },
    {
      "number": 24,
      "arabic": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ",
      "arabicIndopak": "فَلۡيَنۡظُرِ الۡاِنۡسَانُ اِلٰى طَعَامِهٖۤۙ‏",
      "transliteration": "Falyanẓuri-l-ʾinsānu ilā ṭaʿāmih",
      "translation": "Then let mankind look at his food -"
    },
    {
      "number": 25,
      "arabic": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا",
      "arabicIndopak": "اَنَّا صَبَبۡنَا الۡمَآءَ صَبًّا ۙ‏",
      "transliteration": "Annā ṣababnā-l-māʾa ṣabbā",
      "translation": "How We poured down water in torrents,"
    },
    {
      "number": 26,
      "arabic": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا",
      "arabicIndopak": "ثُمَّ شَقَقۡنَا الۡاَرۡضَ شَقًّا ۙ‏",
      "transliteration": "Thumma shaqaqnā-l-ʾarḍa shaqqā",
      "translation": "Then We broke open the earth, splitting [it with sprouts],"
    },
    {
      "number": 27,
      "arabic": "فَأَنۢبَتْنَا فِيهَا حَبًّا",
      "arabicIndopak": "فَاَنۡۢبَتۡنَا فِيۡهَا حَبًّا ۙ‏",
      "transliteration": "Faʾanbatnā fīhā ḥabbā",
      "translation": "And caused to grow within it grain"
    },
    {
      "number": 28,
      "arabic": "وَعِنَبًا وَقَضْبًا",
      "arabicIndopak": "وَّ عِنَبًا وَّقَضۡبًا ۙ‏",
      "transliteration": "Waʿinaban waqaḍbā",
      "translation": "And grapes and herbage"
    },
    {
      "number": 29,
      "arabic": "وَزَيْتُونًا وَنَخْلًا",
      "arabicIndopak": "وَّزَيۡتُوۡنًا وَّنَخۡلًا ؕ‏",
      "transliteration": "Wazaytūnan wanakhlā",
      "translation": "And olive and palm trees"
    },
    {
      "number": 30,
      "arabic": "وَحَدَآئِقَ غُلْبًا",
      "arabicIndopak": "وَحَدَآٮِٕقَ غُلۡبًا ۙ‏",
      "transliteration": "Waḥadāʾiqa ghulbā",
      "translation": "And gardens of dense shrubbery"
    },
    {
      "number": 31,
      "arabic": "وَفَـٰكِهَةً وَأَبًّا",
      "arabicIndopak": "وَّفَاكِهَةً وَّاَبًّا ۙ‏",
      "transliteration": "Wafākihatan waʾabbā",
      "translation": "And fruit and grass -"
    },
    {
      "number": 32,
      "arabic": "مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
      "arabicIndopak": "مَّتَاعًا لَّـكُمۡ وَلِاَنۡعَامِكُمۡؕ‏",
      "transliteration": "Matāʿan lakum waliʾanʿāmikum",
      "translation": "[As] enjoyment for you and your grazing livestock."
    },
    {
      "number": 33,
      "arabic": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
      "arabicIndopak": "فَاِذَا جَآءَتِ الصَّآخَّةُ‏",
      "transliteration": "Faʾidhā jāʾati-ṣ-ṣākhkhat",
      "translation": "But when there comes the Deafening Blast"
    },
    {
      "number": 34,
      "arabic": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
      "arabicIndopak": "يَوۡمَ يَفِرُّ الۡمَرۡءُ مِنۡ اَخِيۡهِۙ‏",
      "transliteration": "Yawma yafirru-l-marʾu min akhīh",
      "translation": "On the Day a man will flee from his brother"
    },
    {
      "number": 35,
      "arabic": "وَأُمِّهِۦ وَأَبِيهِ",
      "arabicIndopak": "وَاُمِّهٖ وَاَبِيۡهِۙ‏",
      "transliteration": "Waʾummihi waʾabīh",
      "translation": "And his mother and his father"
    },
    {
      "number": 36,
      "arabic": "وَصَـٰحِبَتِهِۦ وَبَنِيهِ",
      "arabicIndopak": "وَصَاحِبَتِهٖ وَبَنِيۡهِؕ‏",
      "transliteration": "Waṣāḥibatihi wabanīh",
      "translation": "And his wife and his children,"
    },
    {
      "number": 37,
      "arabic": "لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ",
      "arabicIndopak": "لِكُلِّ امۡرِیءٍ مِّنۡهُمۡ يَوۡمَٮِٕذٍ شَاۡنٌ يُّغۡنِيۡهِؕ‏",
      "transliteration": "Likulli-mriʾin minhum yawmaʾidhin shaʾnun yughnīh",
      "translation": "For every man, that Day, will be a matter adequate for him."
    },
    {
      "number": 38,
      "arabic": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ",
      "arabicIndopak": "وُجُوۡهٌ يَّوۡمَٮِٕذٍ مُّسۡفِرَةٌ ۙ‏",
      "transliteration": "Wujūhun yawmaʾidhin musfirat",
      "translation": "[Some] faces, that Day, will be bright -"
    },
    {
      "number": 39,
      "arabic": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ",
      "arabicIndopak": "ضَاحِكَةٌ مُّسۡتَبۡشِرَةٌ ۚ‏",
      "transliteration": "Ḍāḥikatun mustabshirat",
      "translation": "Laughing, rejoicing at good news."
    },
    {
      "number": 40,
      "arabic": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ",
      "arabicIndopak": "وَوُجُوۡهٌ يَّوۡمَٮِٕذٍ عَلَيۡهَا غَبَرَةٌ ۙ‏",
      "transliteration": "Wawujūhun yawmaʾidhin ʿalayhā ghabarat",
      "translation": "And [other] faces, that Day, will have upon them dust."
    },
    {
      "number": 41,
      "arabic": "تَرْهَقُهَا قَتَرَةٌ",
      "arabicIndopak": "تَرۡهَقُهَا قَتَرَةٌ ؕ‏",
      "transliteration": "Tarhaquhā qatarat",
      "translation": "Blackness will cover them."
    },
    {
      "number": 42,
      "arabic": "أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",
      "arabicIndopak": "اُولٰٓٮِٕكَ هُمُ الۡكَفَرَةُ الۡفَجَرَةُ‏",
      "transliteration": "Ūlāʾika humu-l-kafaratu-l-fajarat",
      "translation": "Those are the disbelievers, the wicked ones."
    }
  ]
}
