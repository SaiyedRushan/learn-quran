{
  "number": 104,
  "arabicName": "سُورَةُ الهُمَزَةِ",
  "englishName": "Al-Humaza",
  "englishNameTranslation": "The Traducer",
  "revelationType": "Meccan",
  "numberOfAyahs": 9,
  "ayahs": [
    {
      "number": 1,
      "arabic": "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ",
      "arabicIndopak": "وَيۡلٌ لِّـكُلِّ هُمَزَةٍ لُّمَزَةِ ۙ‏",
      "transliteration": "Waylun likulli humazatin lumazat",
      "translation": "Woe to every scorner and mocker"
    },
    {
      "number": 2,
      "arabic": "ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ",
      "arabicIndopak": "اۨلَّذِىۡ جَمَعَ مَالًا وَّعَدَّدَهٗ ۙ‏",
      "transliteration": "Alladhī jamaʿa mālan waʿaddadah",
      "translation": "Who collects wealth and [continuously] counts it."
    },
    {
      "number": 3,
      "arabic": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
      "arabicIndopak": "يَحۡسَبُ اَنَّ مَالَهٗۤ اَخۡلَدَهٗ​ ۚ‏",
      "transliteration": "Yaḥsabu anna mālahu akhladah",
      "translation": "He thinks that his wealth will make him immortal."
    },
    {
      "number": 4,
      "arabic": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",
      "arabicIndopak": "كَلَّا​ لَيُنۡۢبَذَنَّ فِى الۡحُطَمَةِ  ۖ‏",
      "transliteration": "Kallā layunbadhanna fī-l-ḥuṭamat",
      "translation": "No! He will surely be thrown into the Crusher."
    },
    {
      "number": 5,
      "arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ",
      "arabicIndopak": "وَمَاۤ اَدۡرٰٮكَ مَا الۡحُطَمَةُ ؕ‏",
      "transliteration": "Wamā adrāka mā-l-ḥuṭamat",
      "translation": "And what can make you know what is the Crusher?"
    },
    {
      "number": 6,
      "arabic": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ",
      "arabicIndopak": "نَارُ اللّٰهِ الۡمُوۡقَدَةُ ۙ‏",
      "transliteration": "Nāru-llāhi-l-mūqadat",
      "translation": "It is the fire of Allah, [eternally] fueled,"
    },
    {
      "number": 7,
      "arabic": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ",
      "arabicIndopak": "الَّتِىۡ تَطَّلِعُ عَلَى الۡاَفۡـــِٕدَةِ ؕ‏",
      "transliteration": "Allatī taṭṭaliʿu ʿalā-l-ʾafʾidat",
      "translation": "Which mounts directed at the hearts."
    },
    {
      "number": 8,
      "arabic": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ",
      "arabicIndopak": "اِنَّهَا عَلَيۡهِمۡ مُّؤۡصَدَةٌ ۙ‏",
      "transliteration": "Innahā ʿalayhim muʾṣadat",
      "translation": "Indeed, Hellfire will be closed down upon them"
    },
    {
      "number": 9,
      "arabic": "فِى عَمَدٍ مُّمَدَّدَةٍۭ",
      "arabicIndopak": "فِىۡ عَمَدٍ مُّمَدَّدَةٍ‏",
      "transliteration": "Fī ʿamadin mumaddadat",
      "translation": "In extended columns."
    }
  ]
}
