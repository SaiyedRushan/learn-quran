{
  "number": 100,
  "arabicName": "سُورَةُ العَادِيَاتِ",
  "englishName": "Al-Aadiyaat",
  "englishNameTranslation": "The Chargers",
  "revelationType": "Meccan",
  "numberOfAyahs": 11,
  "ayahs": [
    {
      "number": 1,
      "arabic": "وَٱلْعَـٰدِيَـٰتِ ضَبْحًا",
      "arabicIndopak": "وَالۡعٰدِيٰتِ ضَبۡحًا ۙ‏",
      "transliteration": "Wal-ʿādiyāti ḍabḥā",
      "translation": "By the racers, panting,"
    },
    {
      "number": 2,
      "arabic": "فَٱلْمُورِيَـٰتِ قَدْحًا",
      "arabicIndopak": "فَالۡمُوۡرِيٰتِ قَدۡحًا ۙ‏",
      "transliteration": "Fal-mūriyāti qadḥā",
      "translation": "And the producers of sparks [when] striking"
    },
    {
      "number": 3,
      "arabic": "فَٱلْمُغِيرَٰتِ صُبْحًا",
      "arabicIndopak": "فَالۡمُغِيۡرٰتِ صُبۡحًا ۙ‏",
      "transliteration": "Fal-mughīrāti ṣubḥā",
      "translation": "And the chargers at dawn,"
    },
    {
      "number": 4,
      "arabic": "فَأَثَرْنَ بِهِۦ نَقْعًا",
      "arabicIndopak": "فَاَثَرۡنَ بِهٖ نَقۡعًا ۙ‏",
      "transliteration": "Faʾatharna bihi naqʿā",
      "translation": "Stirring up thereby [clouds of] dust,"
    },
    {
      "number": 5,
      "arabic": "فَوَسَطْنَ بِهِۦ جَمْعًا",
      "arabicIndopak": "فَوَسَطۡنَ بِهٖ جَمۡعًا ۙ‏",
      "transliteration": "Fawasaṭna bihi jamʿā",
      "translation": "Arriving thereby in the center collectively,"
    },
    {
      "number": 6,
      "arabic": "إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ",
      "arabicIndopak": "اِنَّ الۡاِنۡسَانَ لِرَبِّهٖ لَـكَنُوۡدٌ ۚ‏",
      "transliteration": "Inna-l-ʾinsāna lirabbihi lakanūd",
      "translation": "Indeed mankind, to his Lord, is ungrateful."
    },
    {
      "number": 7,
      "arabic": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ",
      "arabicIndopak": "وَاِنَّهٗ عَلٰى ذٰلِكَ لَشَهِيۡدٌ ۚ‏",
      "transliteration": "Waʾinnahu ʿalā dhālika lashahīd",
      "translation": "And indeed, he is to that a witness."
    },
    {
      "number": 8,
      "arabic": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",
      "arabicIndopak": "وَاِنَّهٗ لِحُبِّ الۡخَيۡرِ لَشَدِيۡدٌ ؕ‏",
      "transliteration": "Waʾinnahu liḥubbi-l-khayri lashadīd",
      "translation": "And indeed he is, in love of wealth, intense."
    },
    {
      "number": 9,
      "arabic": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ",
      "arabicIndopak": "اَفَلَا يَعۡلَمُ اِذَا بُعۡثِرَ مَا فِى الۡقُبُوۡرِۙ‏",
      "transliteration": "afalā yaʿlamu idhā buʿthira mā fī-l-qubūr",
      "translation": "But does he not know that when the contents of the graves are scattered"
    },
    {
      "number": 10,
      "arabic": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ",
      "arabicIndopak": "وَحُصِّلَ مَا فِى الصُّدُوۡرِۙ‏",
      "transliteration": "Waḥuṣṣila mā fī-ṣ-ṣudūr",
      "translation": "And that within the breasts is obtained,"
    },
    {
      "number": 11,
      "arabic": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ",
      "arabicIndopak": "اِنَّ رَبَّهُمۡ بِهِمۡ يَوۡمَٮِٕذٍ لَّخَبِيۡرٌ‏",
      "transliteration": "Inna rabbahum bihim yawmaʾidhin lakhabīr",
      "translation": "Indeed, their Lord with them, that Day, is [fully] Acquainted."
    }
  ]
}
