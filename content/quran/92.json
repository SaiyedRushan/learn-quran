{
  "number": 92,
  "arabicName": "سُورَةُ اللَّيۡلِ",
  "englishName": "Al-Lail",
  "englishNameTranslation": "The Night",
  "revelationType": "Meccan",
  "numberOfAyahs": 21,
  "ayahs": [
    {
      "number": 1,
      "arabic": "وَٱلَّيْلِ إِذَا يَغْشَىٰ",
      "arabicIndopak": "وَالَّيۡلِ اِذَا يَغۡشٰىۙ‏",
      "transliteration": "Wal-layli idhā yaghshā",
      "translation": "By the night when it covers"
    },
    {
      "number": 2,
      "arabic": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
      "arabicIndopak": "وَالنَّهَارِ اِذَا تَجَلّٰىۙ‏",
      "transliteration": "Wan-nahāri idhā tajallā",
      "translation": "And [by] the day when it appears"
    },
    {
      "number": 3,
      "arabic": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "arabicIndopak": "وَمَا خَلَقَ الذَّكَرَ وَالۡاُنۡثٰٓىۙ‏",
      "transliteration": "Wamā khalaqa-dh-dhakara wal-ʾunthā",
      "translation": "And [by] He who created the male and female,"
    },
    {
      "number": 4,
      "arabic": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
      "arabicIndopak": "اِنَّ سَعۡيَكُمۡ لَشَتّٰىؕ‏",
      "transliteration": "Inna saʿyakum lashattā",
      "translation": "Indeed, your efforts are diverse."
    },
    {
      "number": 5,
      "arabic": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
      "arabicIndopak": "فَاَمَّا مَنۡ اَعۡطٰى وَاتَّقٰىۙ‏",
      "transliteration": "Faʾammā man aʿṭā wāttaqā",
      "translation": "As for he who gives and fears Allah"
    },
    {
      "number": 6,
      "arabic": "وَصَدَّقَ بِٱلْحُسْنَىٰ",
      "arabicIndopak": "وَصَدَّقَ بِالۡحُسۡنٰىۙ‏",
      "transliteration": "Waṣaddaqa bil-ḥusnā",
      "translation": "And believes in the best [reward],"
    },
    {
      "number": 7,
      "arabic": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
      "arabicIndopak": "فَسَنُيَسِّرُهٗ لِلۡيُسۡرٰىؕ‏",
      "transliteration": "Fasanuyassiruhu lil-yusrā",
      "translation": "We will ease him toward ease."
    },
    {
      "number": 8,
      "arabic": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
      "arabicIndopak": "وَاَمَّا مَنۡۢ بَخِلَ وَاسۡتَغۡنٰىۙ‏",
      "transliteration": "Waʾammā man bakhila wastaghnā",
      "translation": "But as for he who withholds and considers himself free of need"
    },
    {
      "number": 9,
      "arabic": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
      "arabicIndopak": "وَكَذَّبَ بِالۡحُسۡنٰىۙ‏",
      "transliteration": "Wakadhdhaba bil-ḥusnā",
      "translation": "And denies the best [reward],"
    },
    {
      "number": 10,
      "arabic": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
      "arabicIndopak": "فَسَنُيَسِّرُهٗ لِلۡعُسۡرٰىؕ‏",
      "transliteration": "Fasanuyassiruhu lil-ʿusrā",
      "translation": "We will ease him toward difficulty."
    },
    {
      "number": 11,
      "arabic": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
      "arabicIndopak": "وَمَا يُغۡنِىۡ عَنۡهُ مَالُهٗۤ اِذَا تَرَدّٰىؕ‏",
      "transliteration": "Wamā yughnī ʿanhu māluhu idhā taraddā",
      "translation": "And what will his wealth avail him when he falls?"
    },
    {
      "number": 12,
      "arabic": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
      "arabicIndopak": "اِنَّ عَلَيۡنَا لَـلۡهُدٰىۖ‏",
      "transliteration": "Inna ʿalaynā lal-hudā",
      "translation": "Indeed, [incumbent] upon Us is guidance."
    },
    {
      "number": 13,
      "arabic": "وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ",
      "arabicIndopak": "وَاِنَّ لَـنَا لَـلۡاٰخِرَةَ وَالۡاُوۡلٰى‏",
      "transliteration": "Waʾinna lanā lal-ʾākhirata wal-ʾūlā",
      "translation": "And indeed, to Us belongs the Hereafter and the first [life]."
    },
    {
      "number": 14,
      "arabic": "فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ",
      "arabicIndopak": "فَاَنۡذَرۡتُكُمۡ نَارًا تَلَظّٰى​ۚ‏",
      "transliteration": "Faʾandhartukum nāran talaẓẓā",
      "translation": "So I have warned you of a Fire which is blazing."
    },
    {
      "number": 15,
      "arabic": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى",
      "arabicIndopak": "لَا يَصۡلٰٮهَاۤ اِلَّا الۡاَشۡقَىۙ‏",
      "transliteration": "Lā yaṣlāhā illā-l-ʾashqā",
      "translation": "None will [enter to] burn therein except the most wretched one."
    },
    {
      "number": 16,
      "arabic": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ",
      "arabicIndopak": "الَّذِىۡ كَذَّبَ وَتَوَلّٰىؕ‏",
      "transliteration": "Alladhī kadhdhaba watawallā",
      "translation": "Who had denied and turned away."
    },
    {
      "number": 17,
      "arabic": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى",
      "arabicIndopak": "وَسَيُجَنَّبُهَا الۡاَتۡقَىۙ‏",
      "transliteration": "Wasayujannabuhā-l-ʾatqā",
      "translation": "But the righteous one will avoid it -"
    },
    {
      "number": 18,
      "arabic": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ",
      "arabicIndopak": "الَّذِىۡ يُؤۡتِىۡ مَالَهٗ يَتَزَكّٰى​ۚ‏",
      "transliteration": "Alladhī yuʾtī mālahu yatazakkā",
      "translation": "[He] who gives [from] his wealth to purify himself"
    },
    {
      "number": 19,
      "arabic": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ",
      "arabicIndopak": "وَمَا لِاَحَدٍ عِنۡدَهٗ مِنۡ نِّعۡمَةٍ تُجۡزٰٓىۙ‏",
      "transliteration": "Wamā liʾaḥadin ʿindahu min niʿmatin tujzā",
      "translation": "And not [giving] for anyone who has [done him] a favor to be rewarded"
    },
    {
      "number": 20,
      "arabic": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",
      "arabicIndopak": "اِلَّا ابۡتِغَآءَ وَجۡهِ رَبِّهِ الۡاَعۡلٰى​ۚ‏",
      "transliteration": "Illā-btighāʾa wajhi rabbihi-l-ʾaʿlā",
      "translation": "But only seeking the countenance of his Lord, Most High."
    },
    {
      "number": 21,
      "arabic": "وَلَسَوْفَ يَرْضَىٰ",
      "arabicIndopak": "وَلَسَوۡفَ يَرۡضٰى‏",
      "transliteration": "Walasawfa yarḍā",
      "translation": "And he is going to be satisfied."
    }
  ]
}
