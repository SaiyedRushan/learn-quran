{
  "number": 88,
  "arabicName": "سُورَةُ الغَاشِيَةِ",
  "englishName": "Al-Ghaashiya",
  "englishNameTranslation": "The Overwhelming",
  "revelationType": "Meccan",
  "numberOfAyahs": 26,
  "ayahs": [
    {
      "number": 1,
      "arabic": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ",
      "arabicIndopak": "هَلۡ اَتٰٮكَ حَدِيۡثُ الۡغَاشِيَةِؕ‏",
      "transliteration": "Hal atāka ḥadīthu-l-ghāshiyat",
      "translation": "Has there reached you the report of the Overwhelming [event]?"
    },
    {
      "number": 2,
      "arabic": "وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ",
      "arabicIndopak": "وُجُوۡهٌ يَّوۡمَٮِٕذٍ خَاشِعَةٌ ۙ‏",
      "transliteration": "Wujūhun yawmaʾidhin khāshiʿat",
      "translation": "[Some] faces, that Day, will be humbled,"
    },
    {
      "number": 3,
      "arabic": "عَامِلَةٌ نَّاصِبَةٌ",
      "arabicIndopak": "عَامِلَةٌ نَّاصِبَةٌ ۙ‏",
      "transliteration": "ʿĀmilatun nāṣibat",
      "translation": "Working [hard] and exhausted."
    },
    {
      "number": 4,
      "arabic": "تَصْلَىٰ نَارًا حَامِيَةً",
      "arabicIndopak": "تَصۡلٰى نَارًا حَامِيَةً ۙ‏",
      "transliteration": "Taṣlā nāran ḥāmiyatā",
      "translation": "They will [enter to] burn in an intensely hot Fire."
    },
    {
      "number": 5,
      "arabic": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ",
      "arabicIndopak": "تُسۡقٰى مِنۡ عَيۡنٍ اٰنِيَةٍؕ‏",
      "transliteration": "Tusqā min ʿaynin āniyat",
      "translation": "They will be given drink from a boiling spring."
    },
    {
      "number": 6,
      "arabic": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",
      "arabicIndopak": "لَـيۡسَ لَهُمۡ طَعَامٌ اِلَّا مِنۡ ضَرِيۡعٍۙ‏",
      "transliteration": "Laysa lahum ṭaʿāmun illā min ḍarīʿ",
      "translation": "For them there will be no food except from a poisonous, thorny plant"
    },
    {
      "number": 7,
      "arabic": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ",
      "arabicIndopak": "لَّا يُسۡمِنُ وَلَا يُغۡنِىۡ مِنۡ جُوۡعٍؕ‏",
      "transliteration": "Lā yusminu walā yughnī min jūʿ",
      "translation": "Which neither nourishes nor avails against hunger."
    },
    {
      "number": 8,
      "arabic": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",
      "arabicIndopak": "وُجُوۡهٌ يَّوۡمَٮِٕذٍ نَّاعِمَةٌ ۙ‏",
      "transliteration": "Wujūhun yawmaʾidhin nāʿimat",
      "translation": "[Other] faces, that Day, will show pleasure."
    },
    {
      "number": 9,
      "arabic": "لِّسَعْيِهَا رَاضِيَةٌ",
      "arabicIndopak": "لِّسَعۡيِهَا رَاضِيَةٌ ۙ‏",
      "transliteration": "Lisaʿyihā rāḍiyat",
      "translation": "With their effort [they are] satisfied"
    },
    {
      "number": 10,
      "arabic": "فِى جَنَّةٍ عَالِيَةٍ",
      "arabicIndopak": "فِىۡ جَنَّةٍ عَالِيَةٍۙ‏",
      "transliteration": "Fī jannatin ʿāliyat",
      "translation": "In an elevated garden,"
    },
    {
      "number": 11,
      "arabic": "لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً",
      "arabicIndopak": "لَّا تَسۡمَعُ فِيۡهَا لَاغِيَةً ؕ‏",
      "transliteration": "Lā tasmaʿu fīhā lāghiyatā",
      "translation": "Wherein they will hear no unsuitable speech."
    },
    {
      "number": 12,
      "arabic": "فِيهَا عَيْنٌ جَارِيَةٌ",
      "arabicIndopak": "فِيۡهَا عَيۡنٌ جَارِيَةٌ​ ۘ‏",
      "transliteration": "Fīhā ʿaynun jāriyat",
      "translation": "Within it is a flowing spring."
    },
    {
      "number": 13,
      "arabic": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ",
      "arabicIndopak": "فِيۡهَا سُرُرٌ مَّرۡفُوۡعَةٌ ۙ‏",
      "transliteration": "Fīhā sururun marfūʿat",
      "translation": "Within it are couches raised high"
    },
    {
      "number": 14,
      "arabic": "وَأَكْوَابٌ مَّوْضُوعَةٌ",
      "arabicIndopak": "وَّاَكۡوَابٌ مَّوۡضُوۡعَةٌ ۙ‏",
      "transliteration": "Waʾakwābun mawḍūʿat",
      "translation": "And cups put in place"
    },
    {
      "number": 15,
      "arabic": "وَنَمَارِقُ مَصْفُوفَةٌ",
      "arabicIndopak": "وَّنَمَارِقُ مَصۡفُوۡفَةٌ ۙ‏",
      "transliteration": "Wanamāriqu maṣfūfat",
      "translation": "And cushions lined up"
    },
    {
      "number": 16,
      "arabic": "وَزَرَابِىُّ مَبْثُوثَةٌ",
      "arabicIndopak": "وَّزَرَابِىُّ مَبۡثُوۡثَةٌ ؕ‏",
      "transliteration": "Wazarābiyyu mabthūthat",
      "translation": "And carpets spread around."
    },
    {
      "number": 17,
      "arabic": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
      "arabicIndopak": "اَفَلَا يَنۡظُرُوۡنَ اِلَى الۡاِ بِلِ كَيۡفَ خُلِقَتۡ‏",
      "transliteration": "Afalā yanẓurūna ilā-l-ʾibili kayfa khuliqat",
      "translation": "Then do they not look at the camels - how they are created?"
    },
    {
      "number": 18,
      "arabic": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
      "arabicIndopak": "وَاِلَى السَّمَآءِ كَيۡفَ رُفِعَتۡ‏",
      "transliteration": "Waʾilā-s-samāʾi kayfa rufiʿat",
      "translation": "And at the sky - how it is raised?"
    },
    {
      "number": 19,
      "arabic": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
      "arabicIndopak": "وَاِلَى الۡجِبَالِ كَيۡفَ نُصِبَتۡ‏",
      "transliteration": "Waʾilā-l-jibāli kayfa nuṣibat",
      "translation": "And at the mountains - how they are erected?"
    },
    {
      "number": 20,
      "arabic": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
      "arabicIndopak": "وَاِلَى الۡاَرۡضِ كَيۡفَ سُطِحَتۡ‏",
      "transliteration": "Waʾilā-l-ʾarḍi kayfa suṭiḥat",
      "translation": "And at the earth - how it is spread out?"
    },
    {
      "number": 21,
      "arabic": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ",
      "arabicIndopak": "فَذَكِّرۡ ؕ اِنَّمَاۤ اَنۡتَ مُذَكِّرٌ ؕ‏",
      "transliteration": "Fadhakkir innamā anta mudhakkir",
      "translation": "So remind, [O Muhammad]; you are only a reminder."
    },
    {
      "number": 22,
      "arabic": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
      "arabicIndopak": "لَـسۡتَ عَلَيۡهِمۡ بِمُصَۜيۡطِرٍۙ‏",
      "transliteration": "Lasta ʿalayhim bimuṣayṭir",
      "translation": "You are not over them a controller."
    },
    {
      "number": 23,
      "arabic": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
      "arabicIndopak": "اِلَّا مَنۡ تَوَلّٰى وَكَفَرَۙ‏",
      "transliteration": "Illā man tawallā wakafar",
      "translation": "However, he who turns away and disbelieves -"
    },
    {
      "number": 24,
      "arabic": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",
      "arabicIndopak": "فَيُعَذِّبُهُ اللّٰهُ الۡعَذَابَ الۡاَكۡبَرَؕ‏",
      "transliteration": "Fayuʿadhdhibuhu-llāhu-l-ʿadhāba-l-ʾakbar",
      "translation": "Then Allah will punish him with the greatest punishment."
    },
    {
      "number": 25,
      "arabic": "إِنَّ إِلَيْنَآ إِيَابَهُمْ",
      "arabicIndopak": "اِنَّ اِلَيۡنَاۤ اِيَابَهُمۡۙ‏",
      "transliteration": "Inna ilaynā iyābahum",
      "translation": "Indeed, to Us is their return."
    },
    {
      "number": 26,
      "arabic": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",
      "arabicIndopak": "ثُمَّ اِنَّ عَلَيۡنَا حِسَابَهُمْ‏",
      "transliteration": "Thumma inna ʿalaynā ḥisābahum",
      "translation": "Then indeed, upon Us is their account."
    }
  ]
}
