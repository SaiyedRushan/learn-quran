{
  "number": 96,
  "arabicName": "سُورَةُ العَلَقِ",
  "englishName": "Al-Alaq",
  "englishNameTranslation": "The Clot",
  "revelationType": "Meccan",
  "numberOfAyahs": 19,
  "ayahs": [
    {
      "number": 1,
      "arabic": "ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
      "arabicIndopak": "اِقۡرَاۡ بِاسۡمِ رَبِّكَ الَّذِىۡ خَلَقَ​ۚ‏",
      "transliteration": "Iqraʾ bismi rabbika-lladhī khalaq",
      "translation": "Recite in the name of your Lord who created -"
    },
    {
      "number": 2,
      "arabic": "خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ",
      "arabicIndopak": "خَلَقَ الۡاِنۡسَانَ مِنۡ عَلَقٍ​ۚ‏",
      "transliteration": "Khalaqa-l-ʾinsāna min ʿalaq",
      "translation": "Created man from a clinging substance."
    },
    {
      "number": 3,
      "arabic": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
      "arabicIndopak": "اِقۡرَاۡ وَرَبُّكَ الۡاَكۡرَمُۙ‏",
      "transliteration": "Iqraʾ warabbuka-l-ʾakram",
      "translation": "Recite, and your Lord is the most Generous -"
    },
    {
      "number": 4,
      "arabic": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
      "arabicIndopak": "الَّذِىۡ عَلَّمَ بِالۡقَلَمِۙ‏",
      "transliteration": "Alladhī ʿallama bil-qalam",
      "translation": "Who taught by the pen -"
    },
    {
      "number": 5,
      "arabic": "عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ",
      "arabicIndopak": "عَلَّمَ الۡاِنۡسَانَ مَا لَمۡ يَعۡلَمۡؕ‏",
      "transliteration": "ʿAllama-l-ʾinsāna mā lam yaʿlam",
      "translation": "Taught man that which he knew not."
    },
    {
      "number": 6,
      "arabic": "كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ",
      "arabicIndopak": "كَلَّاۤ اِنَّ الۡاِنۡسَانَ لَيَطۡغٰٓىۙ‏",
      "transliteration": "Kallā inna-l-ʾinsāna layaṭghā",
      "translation": "No! [But] indeed, man transgresses"
    },
    {
      "number": 7,
      "arabic": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
      "arabicIndopak": "اَنۡ رَّاٰهُ اسۡتَغۡنٰىؕ‏",
      "transliteration": "An raʾāhu-staghnā",
      "translation": "Because he sees himself self-sufficient."
    },
    {
      "number": 8,
      "arabic": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
      "arabicIndopak": "اِنَّ اِلٰى رَبِّكَ الرُّجۡعٰىؕ‏",
      "transliteration": "Inna ilā rabbika-r-rujʿā",
      "translation": "Indeed, to your Lord is the return."
    },
    {
      "number": 9,
      "arabic": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",
      "arabicIndopak": "اَرَءَيۡتَ الَّذِىۡ يَنۡهٰىؕ‏",
      "transliteration": "Araʾayta-lladhī yanhā",
      "translation": "Have you seen the one who forbids"
    },
    {
      "number": 10,
      "arabic": "عَبْدًا إِذَا صَلَّىٰٓ",
      "arabicIndopak": "عَبۡدًا اِذَا صَلّٰىؕ‏",
      "transliteration": "ʿAbdan idhā ṣallā",
      "translation": "A servant when he prays?"
    },
    {
      "number": 11,
      "arabic": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",
      "arabicIndopak": "اَرَءَيۡتَ اِنۡ كَانَ عَلَى الۡهُدٰٓىۙ‏",
      "transliteration": "Araʾayta in kāna ʿalā-l-hudā",
      "translation": "Have you seen if he is upon guidance"
    },
    {
      "number": 12,
      "arabic": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",
      "arabicIndopak": "اَوۡ اَمَرَ بِالتَّقۡوٰىۙ‏",
      "transliteration": "Aw amara bit-taqwā",
      "translation": "Or enjoins righteousness?"
    },
    {
      "number": 13,
      "arabic": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
      "arabicIndopak": "اَرَءَيۡتَ اِنۡ كَذَّبَ وَتَوَلّٰىؕ‏",
      "transliteration": "Araʾayta in kadhdhaba watawallā",
      "translation": "Have you seen if he denies and turns away -"
    },
    {
      "number": 14,
      "arabic": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "arabicIndopak": "اَلَمۡ يَعۡلَمۡ بِاَنَّ اللّٰهَ يَرٰىؕ‏",
      "transliteration": "Alam yaʿlam biʾanna-llāha yarā",
      "translation": "Does he not know that Allah sees?"
    },
    {
      "number": 15,
      "arabic": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
      "arabicIndopak": "كَلَّا لَٮِٕنۡ لَّمۡ يَنۡتَهِ  ۙ لَنَسۡفَعًۢا بِالنَّاصِيَةِۙ‏",
      "transliteration": "Kallā laʾin lam yantahi lanasfaʿan bin-nāṣiyat",
      "translation": "No! If he does not desist, We will surely drag him by the forelock -"
    },
    {
      "number": 16,
      "arabic": "نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ",
      "arabicIndopak": "نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ​ ۚ‏",
      "transliteration": "Nāṣiyatin kādhibatin khāṭiʾat",
      "translation": "A lying, sinning forelock."
    },
    {
      "number": 17,
      "arabic": "فَلْيَدْعُ نَادِيَهُۥ",
      "arabicIndopak": "فَلۡيَدۡعُ نَادِيَهٗ ۙ‏",
      "transliteration": "Falyadʿu nādiyah",
      "translation": "Then let him call his associates;"
    },
    {
      "number": 18,
      "arabic": "سَنَدْعُ ٱلزَّبَانِيَةَ",
      "arabicIndopak": "سَنَدۡعُ الزَّبَانِيَةَ ۙ‏",
      "transliteration": "Sanadʿu-z-zabāniyat",
      "translation": "We will call the angels of Hell."
    },
    {
      "number": 19,
      "arabic": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩",
      "arabicIndopak": "كَلَّا ؕ لَا تُطِعۡهُ وَاسۡجُدۡ وَاقۡتَرِبْ۩‏",
      "transliteration": "Kallā lā tuṭiʿhu wasjud waqtarib",
      "translation": "No! Do not obey him. But prostrate and draw near [to Allah]."
    }
  ]
}
